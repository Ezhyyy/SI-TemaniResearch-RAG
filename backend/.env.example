# Application
APP_NAME=TemaniResearch API
DEBUG=True
PORT=8000

# Database Configuration (MySQL recommended)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:@localhost:3306/temaniresearch
# Fallback SQLite jika MySQL belum dibuat:
# DATABASE_URL=sqlite:///./temani_research.db

# JWT Authentication
SECRET_KEY=temaniresearch-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Storage Paths
UPLOAD_DIR=./uploads
CHROMA_PERSIST_DIR=./chroma_db
